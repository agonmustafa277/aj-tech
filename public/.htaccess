# AJ-Tech – Einstellungen für den Apache-Webserver (hosting.de)

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Optional: alle Aufrufe auf https://www.aj-tech.de umleiten.
  # Erst aktivieren (die drei # entfernen), wenn SSL im hosting.de-Panel aktiv ist
  # und die Seite nicht schon dort umgeleitet wird.
  # RewriteCond %{HTTPS} off [OR]
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^ https://www.aj-tech.de%{REQUEST_URI} [R=301,L]

  # /impressum/ -> /impressum (eine einheitliche Adresse für Google)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /impressum liefert die vorgerenderte Datei /impressum/index.html aus
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ /$1/index.html [L]
</IfModule>

<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

# Konfiguration und Vorlagen nicht ausliefern
<FilesMatch "^kontakt-config(\.example)?\.php$">
  Require all denied
</FilesMatch>

# Komprimierung
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/xml
</IfModule>

# Caching: Dateien in /assets haben Prüfsummen im Namen und ändern sich nie.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^(favicon\.png|og-image\.png|aj-tech-logo.*\.svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
